NODE_ENV=development
PORT=5004

# PostgreSQL
DATABASE_URL=postgres://<db_user>:<db_password>@localhost:5432/ecommerce

# Auth
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# Optional OAuth 2.0 / OpenID Connect
# External bearer-token verification requires AUTH_DOMAIN and AUTH_AUDIENCE.
# Browser redirect login additionally requires AUTH_CLIENT_ID and AUTH_CLIENT_SECRET.
# AUTH_DOMAIN=tenant.example.com
# AUTH_AUDIENCE=https://api.example.com
# AUTH_ISSUER=https://tenant.example.com/
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_BASE_URL=http://localhost:5004

# Payments
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_PUBLIC_KEY=pk_test_your_key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=ecommerce-api
