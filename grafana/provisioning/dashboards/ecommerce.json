      "title": "HTTP Request Duration",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_sum[5m])",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "title": "Total Orders",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "order_total"
        }
      ]
    },
    {
      "title": "Active Users",
      "type": "gauge",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "active_users"
        }
      ]
    }
